{
  "schemaVersion": 1,
  "id": "datarewriter",
  "version": "${version}",
  "name": "DataRewriter",
  "description": "KubeJS knockoff?",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/datarewriter/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.ledok.datarewriter.client.DatarewriterClient"
    ],
    "main": [
      "net.ledok.datarewriter.Datarewriter"
    ],
    "emi": [
      "net.ledok.datarewriter.client.emi.DataRewriterEmiPlugin"
    ]
  },
  "mixins": [
    "datarewriter.mixins.json",
    {
      "config": "datarewriter.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
